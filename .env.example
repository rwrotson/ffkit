# Settings for the ffkit command. Every FFKIT_* value is optional; defaults live in
# ffkit.cli.settings.Settings. Nested sections use a double underscore. Uncomment a line to
# override it. The library itself does not read these variables.

# Logging
# FFKIT_LOG__LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
# FFKIT_LOG__CONSOLE_LEVEL=DEBUG
# FFKIT_LOG__FILE_LEVEL=INFO
# FFKIT_LOG__FORMAT=console                  # console or json; file logs are always JSON
# FFKIT_LOG__DIR=./logs                      # file logging is disabled if unset
# FFKIT_LOG__FILE_NAME=ffkit.log            # basename only; no directory separators
# FFKIT_LOG__FILE_MAX_BYTES=4194304
# FFKIT_LOG__FILE_BACKUP_COUNT=5

# FFmpeg
# FFKIT_FFMPEG__FFMPEG_PATH=ffmpeg           # bare names are resolved from PATH
# FFKIT_FFMPEG__FFPROBE_PATH=ffprobe
# FFKIT_FFMPEG__PROCESS_TIMEOUT=900          # seconds
# FFKIT_FFMPEG__STREAM_IDLE_TIMEOUT=30       # seconds
